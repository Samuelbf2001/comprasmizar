    {"id":"sequence-t","type":"text","x":1174,"y":770,"width":602,"height":190,"angle":0,"strokeColor":"#14532d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"d5","roundness":null,"seed":222,"version":1,"versionNonce":222,"isDeleted":false,"boundElements":null,"updated":1780000000000,"link":null,"locked":false,"text":"RUTA CRÍTICA PROPUESTA\n\n1. Desplegar: DNS + EasyPanel + secretos\n2. Cargar maestros reales y teléfonos autorizados\n3. Publicar Flow y conectar webhook Kapso\n4. Ejecutar mes de paridad y validar Helisa\n5. UAT, capacitación y primera semana acompañada\n\nRegla de cierre: no declarar producción antes de 1–5.","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RUTA CRÍTICA PROPUESTA\n\n1. Desplegar: DNS + EasyPanel + secretos\n2. Cargar maestros reales y teléfonos autorizados\n3. Publicar Flow y conectar webhook Kapso\n4. Ejecutar mes de paridad y validar Helisa\n5. UAT, capacitación y primera semana acompañada\n\nRegla de cierre: no declarar producción antes de 1–5.","autoResize":true,"lineHeight":1.25},

