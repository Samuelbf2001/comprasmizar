    {
      "id": "RESUMEN",
      "title": "Resumen",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Revisa antes de enviar"
          },
          {
            "type": "TextBody",
            "text": "Obra: ${screen.TIPO_Y_OBRA.form.obra}"
          },
          {
            "type": "TextBody",
            "text": "Tipo: ${screen.TIPO_Y_OBRA.form.tipo_solicitud}"
          },
          {
            "type": "TextBody",
            "text": "Fecha requerida: ${screen.DETALLES.form.fecha_requerida}"
          },
          {
            "type": "TextBody",
            "text": "Artículo 1: ${screen.ARTICULO_UNO.form.descripcion}"
          },
          {
            "type": "Footer",
            "label": "Enviar solicitud",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "type": "${screen.TIPO_Y_OBRA.form.tipo_solicitud}",
                "workId": "${screen.TIPO_Y_OBRA.form.obra}",
                "requiredDate": "${screen.DETALLES.form.fecha_requerida}",
                "destination": "${screen.DETALLES.form.destino}",
                "observations": "${screen.DETALLES.form.observaciones}",
                "item_1_catalogo": "${screen.ARTICULO_UNO.form.catalogo}",
                "item_1_descripcion": "${screen.ARTICULO_UNO.form.descripcion}",
                "item_1_cantidad": "${screen.ARTICULO_UNO.form.cantidad}",
                "item_1_unidad": "${screen.ARTICULO_UNO.form.unidad}",
                "item_1_proveedor": "${screen.ARTICULO_UNO.form.proveedor}",
                "item_1_link": "${screen.ARTICULO_UNO.form.link}",
                "item_2_catalogo": "${screen.ARTICULO_DOS.form.catalogo}",
                "item_2_descripcion": "${screen.ARTICULO_DOS.form.descripcion}",
                "item_2_cantidad": "${screen.ARTICULO_DOS.form.cantidad}",
                "item_2_unidad": "${screen.ARTICULO_DOS.form.unidad}",
