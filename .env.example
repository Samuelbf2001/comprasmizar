# Postgres autoalojado (migracion 2026-09-10, ver docs/migracion-autoalojado.md).
# En el VPS apunta al servicio `db` de compose.yaml, que no expone puerto publico:
#   postgresql://mizar:<contrasena>@db:5432/mizar
DATABASE_URL=

# Almacenamiento privado de adjuntos en disco propio, en reemplazo de Supabase Storage.
# STORAGE_ROOT es OBLIGATORIA y sin valor por defecto a proposito: un default absoluto haria que
# un entorno mal configurado escribiera soportes en una ruta que nadie respalda, en silencio.
# En el contenedor es /var/lib/mizar/storage (volumen storage_data); en local, cualquier carpeta.
STORAGE_ROOT=
# >=32 caracteres. Firma los enlaces de subida/descarga de adjuntos. Rotarla invalida los enlaces
# ya emitidos (15 min los de subida, 60 s los de descarga), no los archivos ya guardados.
STORAGE_SIGNING_SECRET=

# Public request form. Replace before exposing the route.
PUBLIC_FORM_CODE_PEPPER=

# Kapso adapter and embedded inbox.
# KAPSO_EMBED_URL es una credencial portadora: solo servidor, la entrega
# /api/kapso-embed a sesiones autorizadas. Nunca usar NEXT_PUBLIC_* para esto.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
KAPSO_EMBED_URL=

# Emisor del WhatsApp Flow "Requisición de obra" (RF-902, lib/infrastructure/flow-sender.ts).
# ID del Flow a enviar. El borrador real verificado contra la API de Meta es 1972861836748301
# (ver integrations/whatsapp-flow/README.md) — se deja comentado como referencia, no como
# valor activo, porque enviar sin querer contra el Flow real de producción no debe ser el
# comportamiento por defecto de un checkout local.
# WHATSAPP_FLOW_ID=1972861836748301
# Texto del botón CTA del mensaje. Opcional; por defecto "Solicitar".
# WHATSAPP_FLOW_CTA=Solicitar
# Texto de interactive.body.text. Meta lo exige en todo mensaje interactivo salvo
# location_request_message; opcional aquí, con un valor por defecto razonable.
# WHATSAPP_FLOW_BODY=Solicita materiales o pagos para tu obra directamente desde WhatsApp.
# El Flow puede estar en "draft" o "published". Meta asume "published" si se omite, y el Flow
# de arriba HOY es un borrador: para probarlo hace falta "draft" explícito. Cuando se publique
# el Flow, quitar esta variable (o ponerla en "published").
# WHATSAPP_FLOW_MODE=draft

# --- WhatsApp Flow de APROBACIÓN (integrations/whatsapp-flow/aprobacion.flow.json) ---
# Es OTRO Flow publicado en Meta, con su propio id: el aprobador asignado revisa los ítems ya
# cotizados y aprueba o devuelve sin salir del chat. Mientras esta variable esté vacía, la
# notificación "pendiente_aprobador" sigue saliendo como la plantilla de texto de siempre: el
# canal se activa solo, sin tocar código, el día que se cargue el id del Flow.
# Se crea/actualiza el borrador con: npx tsx scripts/publish-whatsapp-flow.ts aprobacion
# WHATSAPP_APPROVAL_FLOW_ID=
# Texto del botón CTA. Opcional; por defecto "Revisar".
# WHATSAPP_APPROVAL_FLOW_CTA=Revisar
# Texto de interactive.body.text. Opcional, con valor por defecto razonable.
# WHATSAPP_APPROVAL_FLOW_BODY=Tienes una requisición esperando tu aprobación.
# Igual que el Flow de captura: "draft" mientras el Flow sea borrador, quitar al publicarlo.
# WHATSAPP_APPROVAL_FLOW_MODE=draft
# Plantilla de utilidad con botón de Flow: el ÚNICO camino que atraviesa la ventana de 24 h de
# WhatsApp (un mensaje interactivo suelto se rechaza con 422 fuera de ella). Se crea con
# scripts/publish-approval-template.ts y la aprueba Meta. Solo hace falta cambiar estas variables
# si la plantilla se registra con otro nombre o idioma.
# WHATSAPP_APPROVAL_TEMPLATE=aprobacion_requisicion
# WHATSAPP_APPROVAL_TEMPLATE_LANG=es

# Secreto compartido de los endpoints internos que envían un WhatsApp Flow a mano
# (POST /api/internal/send-flow y POST /api/internal/send-approval-flow, header
# x-dispatch-secret). Propio y distinto de NOTIFICATION_DISPATCH_SECRET: ese autoriza drenar
# una cola ya validada, este autoriza empujar un mensaje real de WhatsApp. Sin este valor los
# endpoints responden 503: cerrados por defecto.
SEND_FLOW_SECRET=

# MCP capability keys are stored hashed in Postgres.
MCP_KEY_PEPPER=

# Secreto compartido del endpoint interno que drena la cola de notificaciones
# (POST /api/internal/dispatch-notifications, header x-dispatch-secret).
# Sin este valor el endpoint responde 503: cerrado por defecto.
NOTIFICATION_DISPATCH_SECRET=

# Canonical deployment URL
# OJO con el puerto: `mizar-dev` (.claude/launch.json, el que usa `npm run dev`) sirve en 3001, no
# en 3000. Si esta variable no coincide con el puerto real, `assertSameOrigin` rechaza TODA escritura
# con "Origen de solicitud no permitido" — un 403 que no menciona el puerto por ningún lado y se
# confunde con un problema de permisos. En producción va el dominio público.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Literal "true" enables the local demo selector/data mode. Any other value fails closed to auth.
NEXT_PUBLIC_DEMO_MODE=false

# Respaldo diario cifrado a Google Drive (ops/backup-daily.sh). NO van en .env.production: el cron
# los lee de /opt/mizar/.env.backup con permisos 600. Ver docs/migracion-autoalojado.md paso 4.
# BACKUP_PASSPHRASE debe guardarse FUERA del VPS: si se pierde con el servidor, los respaldos
# cifrados no sirven para nada.
# BACKUP_PASSPHRASE=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# GDRIVE_FOLDER_ID=
