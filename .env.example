# Supabase managed data plane
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct/pooler connection used only by server-side transactional repositories.
DATABASE_URL=

# Public request form. Replace before exposing the route.
PUBLIC_FORM_CODE_PEPPER=

# Kapso adapter and embedded inbox.
# KAPSO_EMBED_URL es una credencial portadora: solo servidor, la entrega
# /api/kapso-embed a sesiones autorizadas. Nunca usar NEXT_PUBLIC_* para esto.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
KAPSO_EMBED_URL=

# MCP capability keys are stored hashed in Postgres.
MCP_KEY_PEPPER=

# Secreto compartido del endpoint interno que drena la cola de notificaciones
# (POST /api/internal/dispatch-notifications, header x-dispatch-secret).
# Sin este valor el endpoint responde 503: cerrado por defecto.
NOTIFICATION_DISPATCH_SECRET=

# Canonical deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Literal "true" enables the local demo selector/data mode. Any other value fails closed to auth.
NEXT_PUBLIC_DEMO_MODE=false
