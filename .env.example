# Supabase managed data plane
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct/pooler connection used only by server-side transactional repositories.
DATABASE_URL=

# Public request form. Replace before exposing the route.
PUBLIC_FORM_CODE_PEPPER=

# Kapso adapter and embedded inbox.
# KAPSO_EMBED_URL es una credencial portadora: solo servidor, la entrega
# /api/kapso-embed a sesiones autorizadas. Nunca usar NEXT_PUBLIC_* para esto.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
KAPSO_EMBED_URL=

# Emisor del WhatsApp Flow "Requisición de obra" (RF-902, lib/infrastructure/flow-sender.ts).
# ID del Flow a enviar. El borrador real verificado contra la API de Meta es 1972861836748301
# (ver integrations/whatsapp-flow/README.md) — se deja comentado como referencia, no como
# valor activo, porque enviar sin querer contra el Flow real de producción no debe ser el
# comportamiento por defecto de un checkout local.
# WHATSAPP_FLOW_ID=1972861836748301
# Texto del botón CTA del mensaje. Opcional; por defecto "Solicitar".
# WHATSAPP_FLOW_CTA=Solicitar
# Texto de interactive.body.text. Meta lo exige en todo mensaje interactivo salvo
# location_request_message; opcional aquí, con un valor por defecto razonable.
# WHATSAPP_FLOW_BODY=Solicita materiales o pagos para tu obra directamente desde WhatsApp.
# El Flow puede estar en "draft" o "published". Meta asume "published" si se omite, y el Flow
# de arriba HOY es un borrador: para probarlo hace falta "draft" explícito. Cuando se publique
# el Flow, quitar esta variable (o ponerla en "published").
# WHATSAPP_FLOW_MODE=draft

# Secreto compartido del endpoint interno que envía el WhatsApp Flow a un número dado
# (POST /api/internal/send-flow, header x-dispatch-secret). Propio y distinto de
# NOTIFICATION_DISPATCH_SECRET: ese autoriza drenar una cola ya validada, este autoriza
# empujar un mensaje real a cualquier número que decida el llamador. Sin este valor el
# endpoint responde 503: cerrado por defecto.
SEND_FLOW_SECRET=

# MCP capability keys are stored hashed in Postgres.
MCP_KEY_PEPPER=

# Secreto compartido del endpoint interno que drena la cola de notificaciones
# (POST /api/internal/dispatch-notifications, header x-dispatch-secret).
# Sin este valor el endpoint responde 503: cerrado por defecto.
NOTIFICATION_DISPATCH_SECRET=

# Canonical deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Literal "true" enables the local demo selector/data mode. Any other value fails closed to auth.
NEXT_PUBLIC_DEMO_MODE=false
